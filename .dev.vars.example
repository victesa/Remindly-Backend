# Cloudflare Wrangler local development secrets
# Copy this file to .dev.vars and fill real values.

GEMINI_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"","client_id":"","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"","universe_domain":"googleapis.com"}

# GOOGLE_PLAY_PACKAGE_NAME: Android application ID as published on Google Play, e.g. com.example.remindly.
GOOGLE_PLAY_PACKAGE_NAME=

# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON: (Optional) Service account with API access granted in Play Console > Users and permissions.
# Falls back to FIREBASE_SERVICE_ACCOUNT_JSON if this project's Firebase service account was granted Play Console access.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# RTDN_WEBHOOK_TOKEN: Shared secret appended as ?token=... to the Pub/Sub push subscription URL to reject spoofed calls.
# Used only as a fallback when RTDN_EXPECTED_AUDIENCE is not set.
RTDN_WEBHOOK_TOKEN=

# RTDN_EXPECTED_AUDIENCE: The audience configured on the Pub/Sub push subscription's OIDC token (recommended).
# When set, RTDN requests are verified against Google's public JWKS instead of the shared secret.
RTDN_EXPECTED_AUDIENCE=

# RTDN_EXPECTED_SERVICE_ACCOUNT_EMAIL: (Optional) Restrict RTDN verification to a specific Pub/Sub push service account.
RTDN_EXPECTED_SERVICE_ACCOUNT_EMAIL=

# ANALYTICS_ADMIN_KEY: Secret required to read /v1/analytics/summary.
ANALYTICS_ADMIN_KEY=

# Local-only test-token support. Keep false or unset in deployed environments.
ALLOW_DEV_AUTH=true
